# Shared local placeholders. Copy to .env and keep real values out of git.
LOG_LEVEL=INFO

# Used when running uvicorn on the host. Docker Compose overrides this
# to http://job-processor:8001 so the API uses the Compose DNS name.
PROCESSOR_BASE_URL=http://localhost:8001
PROCESSOR_TIMEOUT_SECONDS=10
MAX_URLS_PER_JOB=10
URL_TIMEOUT_SECONDS=3

# Compose uses host name `postgres`. Host-run uvicorn can use localhost.
DATABASE_URL=postgresql://taskflow:changeme@localhost:5432/taskflow
